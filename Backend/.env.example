# Copy to .env and fill in. Never commit .env.
SERVER_URL=localhost
PORT=8900
ENV=dev
LOG_LEVEL=INFO

# OpenRouter — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_TIMEOUT_SEC=120
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_MAX_ATTEMPTS=5

# Optional, sent as HTTP-Referer / X-Title for OpenRouter rankings
APP_SITE_URL=http://localhost:8900
APP_TITLE=CalcDraw

# Image downscale: longest side in px before upload (controls cost/latency)
MAX_IMAGE_SIDE_PX=1568
